{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/.turbo/**",
      "**/state/**",
      "**/.next/**",
      "**/next-env.d.ts",
      "apps/web/public/landing.js",
      "**/tap02/vectors/vectors.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "include": [
        "apps/web/components/playground/CircuitDiagram.tsx",
        "apps/web/components/sandbox/Header.tsx"
      ],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    }
  ]
}
