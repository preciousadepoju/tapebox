# Bearer token the faucet backend (apps/web API route) sends to call anvil_* through the proxy.
# Generate: openssl rand -hex 32   — keep the real value only in infra/.env and Vercel env vars.
ADMIN_TOKEN=
DOMAIN=rpc.example.com
FORK_URL=https://rpc.xlayer.tech
FORK_BLOCK=77014830
RATE_PER_MIN=600
PROXY_PORT=8080

# Download URL of the published fork snapshot (a GitHub release asset). State dumps are
# gitignored, so fetch-state.sh pulls this into ../state/xlayer-fork.json before boot.
# Produce one with `pnpm spike`, then `gh release create fork-state state/xlayer-fork.json`.
STATE_URL=
