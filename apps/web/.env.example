# Copy to apps/web/.env.local. Leave TAPEBOX_RPC unset to run the app in mock mode (no chain needed).

# Server only. RPC the faucet route uses to call fund(). Point it at the anvil fork or at the
# infra proxy (the admin token lets cheat methods such as anvil_setStorageAt through).
TAPEBOX_RPC=http://127.0.0.1:8545
# Server only. Never prefix with NEXT_PUBLIC_. Must match ADMIN_TOKEN in infra/.env when going through the proxy.
TAPEBOX_ADMIN_TOKEN=

# Public RPC the browser talks to (reads, burner wallet raw transactions). Use the public proxy URL in production.
# Baked in at build time.
NEXT_PUBLIC_TAPEBOX_RPC=http://127.0.0.1:8545

# Faucet rate limits (in-memory, per server instance).
FAUCET_ADDRESS_LIMIT=1
FAUCET_ADDRESS_WINDOW_SECONDS=21600
FAUCET_IP_LIMIT=5
FAUCET_IP_WINDOW_SECONDS=3600
