{
  "name": "@zevbuilds/tapebox",
  "version": "0.1.0",
  "description": "A free X Layer mainnet fork for TapeOut builders: real contracts, free test transistors, a test runner and a circuit builder.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/preciousadepoju/tapebox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preciousadepoju/tapebox.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/preciousadepoju/tapebox/issues"
  },
  "keywords": ["x-layer", "tapeout", "ethereum", "circuits", "anvil", "fork", "nand", "cli"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tapebox": "./dist/index.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "jiti": "^2.4.2",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "viem": "^2.21.54",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tapebox/fork": "workspace:*",
    "@tapebox/sdk": "workspace:*",
    "@tapebox/shared": "workspace:*",
    "@tapebox/tap02": "workspace:*"
  }
}
